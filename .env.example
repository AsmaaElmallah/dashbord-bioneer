# انسخ إلى .env واملأ من Supabase → Project Settings → API
# للإنتاج: انسخي أيضاً .env.production.example

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# اختياري: تفعيل Supabase في اللوحة (إن false يبقى localStorage)
VITE_USE_SUPABASE=false

# تحذير أمني: استخدمي anon/public فقط — لا تضيفي service_role أبداً في الواجهة
